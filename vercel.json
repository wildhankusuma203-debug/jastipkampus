{
  "version": 2,
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_CONFIG_CACHE": "/tmp/config-v4.php",
    "APP_EVENTS_CACHE": "/tmp/events-v4.php",
    "APP_PACKAGES_CACHE": "/tmp/packages-v4.php",
    "APP_ROUTES_CACHE": "/tmp/routes-v4.php",
    "APP_SERVICES_CACHE": "/tmp/services-v4.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "APP_STORAGE": "/tmp/storage",
    "CACHE_STORE": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "database"
  }
}